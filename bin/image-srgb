#!/usr/bin/env bash

# converts images to sRGB using a perceptual conversion

# Usage:
# image-srgb *.jpg
# image-srgb --output ./srgb *.jpg

# to resize a folder of jpgs, ensuring correct colour profile conversion to sRGB, use:
# image-resize ./* --size 2500 --output ./web && image-srgb ./web/*

# to resize and then convert a folder of pngs to webp, use:
# image-resize *.png --size 2500 --output ./web && \
# image-srgb ./web/* && \
# image-webp ./web/* --output ./webp

set -euo pipefail
shopt -s nullglob
trap 'echo "Interrupted"; exit 130' INT

OUTDIR=""
files=()

while (( "$#" )); do
    case "$1" in
        --output)
            OUTDIR="${2:-}"
            shift 2
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            files+=("$1")
            shift
            ;;
    esac
done

if (( ${#files[@]} == 0 )); then
    echo "No images provided"
    exit 1
fi

total=${#files[@]}
done_count=0

if [[ -n "$OUTDIR" ]]; then
    mkdir -p "$OUTDIR"
fi

for file in "${files[@]}"; do

    [[ -f "$file" ]] || continue

    dir="$(dirname "$file")"
    filename="$(basename "$file")"
    name="${filename%.*}"
    ext="${filename##*.}"

    if [[ -n "$OUTDIR" ]]; then
        out="${OUTDIR}/${filename}"
    else
        out="${file}"
    fi

    if ! magick "$file" \
        -intent Perceptual \
        -profile "/System/Library/ColorSync/Profiles/sRGB Profile.icc" \
        "$out"
    then
        echo "srgb – conversion failed: $file"
        continue
    fi

    done_count=$((done_count + 1))
    echo "srgb: $file ($done_count/$total)"
done

echo "srgb – converted $done_count/$total"