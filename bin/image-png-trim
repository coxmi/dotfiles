#!/usr/bin/env bash

# trims PNG images to their non-transparent pixels (default --axis xy)

# Usage:
# image-png-trim *.png --axis x --output ./out
# image-png-trim *.png --axis y --output ./out
# image-png-trim *.png --axis xy --output ./out

set -euo pipefail
shopt -s nullglob
trap 'echo "Interrupted"; exit 130' INT

axis="xy"
OUTDIR=""
files=()

while (( "$#" )); do
    case "$1" in
        --axis)
            axis="$2"
            shift 2
            ;;
        --output)
            OUTDIR="${2:-}"
            shift 2
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            files+=("$1")
            shift
            ;;
    esac
done


if (( ${#files[@]} == 0 )); then
    echo "No images provided"
    exit 1
fi

total=${#files[@]}
done_count=0

if [[ -n "$OUTDIR" ]]; then
    mkdir -p "$OUTDIR"
fi

for file in "${files[@]}"; do
    [[ -e "$file" ]] || continue

    dir="$(dirname "$file")"
    filename="$(basename "$file")"
    name="${filename%.*}"
    ext="${filename##*.}"

    if [[ -n "$OUTDIR" ]]; then
        out="${OUTDIR}/${filename}"
    else
        out="${file}"
    fi

    if [[ "$axis" == "xy" ]]; then
        magick "$file" -alpha on -trim +repage "$out"
        done_count=$((done_count + 1))
        echo "png-trim: $file ($done_count/$total)"
        continue
    fi

    orig_dims=$(magick identify -format "%w %h" "$file")
    read -r orig_w orig_h <<< "$orig_dims"

    trimmed_dims=$(magick "$file" -alpha on -trim -format "%w %h %X %Y" info:)
    read -r width height x y <<< "$trimmed_dims"

    crop_w=$orig_w
    crop_h=$orig_h
    offset_x=0
    offset_y=0

    if [[ "$axis" == "x" ]]; then
        crop_w=$width
        offset_x=$x
    fi

    if [[ "$axis" == "y" ]]; then
        crop_h=$height
        offset_y=$y
    fi

    magick "$file" -alpha on -crop "${crop_w}x${crop_h}+${offset_x}+${offset_y}" +repage "$out"

    done_count=$((done_count + 1))
    echo "png-trim: $file ($done_count/$total)"
done

echo "png-trim – trimmed $done_count/$total"