#!/usr/bin/env bash

# Converts to webp

# Usage:
# image-webp *.png
# image-webp *.png --output ./webp 
# image-webp *.png --output ./webp --quality 85 
# image-webp *.png --output ./webp --lossless

# to resize a folder of jpgs, ensuring correct colour profile conversion to sRGB, use:
# image-resize ./* --size 2500 --output ./web && image-srgb ./web/*

# to resize and then convert a folder of pngs to webp, use:
# image-resize *.png --size 2500 --output ./web && \
# image-srgb ./web/* && \
# image-webp ./web/* --output ./webp

set -euo pipefail
shopt -s nullglob
trap 'echo "Interrupted"; exit 130' INT

QUALITY=80
LOSSLESS=0
OUTDIR=""
files=()

while (( "$#" )); do
    case "$1" in
        --output)
            OUTDIR="${2:-}"
            shift 2
            ;;
        --quality)
            QUALITY="${2:-}"
            shift 2
            ;;
        --lossless)
            LOSSLESS=1
            shift
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            files+=("$1")
            shift
            ;;
    esac
done

# Validate quality (only relevant if not lossless)
if [[ "$LOSSLESS" -eq 0 ]]; then
    if ! [[ "$QUALITY" =~ ^[0-9]+$ ]] || (( QUALITY < 0 || QUALITY > 100 )); then
        echo "Invalid quality (0-100): $QUALITY"
        exit 1
    fi
fi

# validate images exist
if (( ${#files[@]} == 0 )); then
    echo "No images provided"
    exit 1
fi

total=${#files[@]}
done_count=0

if [[ -n "$OUTDIR" ]]; then
    mkdir -p "$OUTDIR"
fi

for file in "${files[@]}"; do
    [[ -f "$file" ]] || continue

    dir="$(dirname "$file")"
    filename="$(basename "$file")"
    name="${filename%.*}"
    ext="${filename##*.}"

    if [[ -n "$OUTDIR" ]]; then
        out="${OUTDIR}/${name}.webp"
    else
        out="${dir}/${name}.webp"
    fi

    if [[ "$LOSSLESS" -eq 1 ]]; then
        if ! magick "$file" -define webp:lossless=true "$out" 2>/dev/null; then
            echo "webp – lossless conversion failed: $file"
            continue
        fi
    else
        if ! magick "$file" -quality "$QUALITY" "$out" 2>/dev/null; then
            echo "webp – conversion failed: $file"
            continue
        fi
    fi

    done_count=$((done_count + 1))
    echo "webp: $file ($done_count/$total)"
done

echo "webp – converted $done_count/$total"