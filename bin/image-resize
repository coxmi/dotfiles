#!/usr/bin/env bash

# Resizes images using the longest dimension (width vs height)

# Usage:
# image-resize *.jpg --size 2500
# image-resize *.jpg --size 2500 --output ./2500 

# to resize a folder of jpgs, ensuring correct colour profile conversion to sRGB, use:
# image-resize ./* --size 2500 --output ./web && image-srgb ./web/*

# to resize and then convert a folder of pngs to webp, use:
# image-resize *.png --size 2500 --output ./web && \
# image-srgb ./web/* && \
# image-webp ./web/* --output ./webp

set -euo pipefail
shopt -s nullglob
trap 'echo "Interrupted"; exit 130' INT

SIZE=""
OUTDIR=""
files=()

while (( "$#" )); do
    case "$1" in
        --size)
            SIZE="${2:-}"
            shift 2
            ;;
        --output)
            OUTDIR="${2:-}"
            shift 2
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            files+=("$1")
            shift
            ;;
    esac
done

if [[ -z "$SIZE" ]]; then
    echo "Missing required flag: --size"
    exit 1
fi

if (( ${#files[@]} == 0 )); then
    echo "No images provided"
    exit 1
fi

total=${#files[@]}
done_count=0

if [[ -n "$OUTDIR" ]]; then
    mkdir -p "$OUTDIR"
fi

for file in "${files[@]}"; do
    [[ -f "$file" ]] || continue

    dir="$(dirname "$file")"
    filename="$(basename "$file")"
    name="${filename%.*}"
    ext="${filename##*.}"

    if [[ -n "$OUTDIR" ]]; then
        out="${OUTDIR}/${filename}"
    else
        out="${file}"
    fi

    if ! dims=$(magick identify -format "%w %h" "$file" 2>/dev/null); then
        echo "resize – failed to read dimensions: $file"
        continue
    fi

    read -r width height <<< "$dims"

    if [[ -z "${width:-}" || -z "${height:-}" ]]; then
        echo "resize – invalid dimensions: $file"
        continue
    fi

    if ! [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]]; then
        echo "resize – non-numeric dimensions: $file"
        continue
    fi

    if (( height > width )); then
        magick "$file" -resize "x${SIZE}>" "$out"
    else
        magick "$file" -resize "${SIZE}x>" "$out"
    fi

    done_count=$((done_count + 1))
    echo "resize: $file ($done_count/$total)"
done

echo "resize $SIZE – converted $done_count/$total"